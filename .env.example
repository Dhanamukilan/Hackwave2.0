# ---- GitHub (real repo integration) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ag004
POSTGRES_USER=ag004
POSTGRES_PASSWORD=changeme

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=failure_embeddings

# ---- Local LLM (Ollama, OpenAI-compatible) ----
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=not-needed-for-local

# ---- Backend ----
JWT_SECRET=
ADMIN_BOOTSTRAP_PASSWORD=
# Note: In production, ADMIN_BOOTSTRAP_PASSWORD is required. In local dev, if omitted, a cryptographically secure password is generated and logged once.
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
