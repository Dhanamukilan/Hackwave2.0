{
  "benchmark_name": "AG004 Synthetic CI/CD Failure Benchmark",
  "version": "1.0",
  "description": "Ground truth labeled failure logs across 10 classification categories for cold-start evaluation",
  "min_real_samples_threshold": 200,
  "samples_count": 50,
  "categories": [
    "REGRESSION",
    "FLAKY_TEST",
    "INFRASTRUCTURE",
    "ENVIRONMENT",
    "DEPENDENCY",
    "NETWORK",
    "TIMEOUT",
    "BUILD_FAILURE",
    "TEST_DATA",
    "UNKNOWN"
  ],
  "samples": [
